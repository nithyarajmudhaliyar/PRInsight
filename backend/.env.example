# ── REQUIRED ────────────────────────────────────────────────────────────────
# GitHub Personal Access Token (required — app will not start without this)
# Obtain from: GitHub → Settings → Developer settings → Personal access tokens
# Required scope: public_repo (read-only access to public repositories)
GITHUB_TOKEN=ghp_your_personal_access_token_here

# ── OPTIONAL ────────────────────────────────────────────────────────────────
# Application
DEBUG=true
LOG_LEVEL=DEBUG

# CORS — allowed frontend origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173"]

# Cache — in-memory TTL cache settings
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=100

# Concurrency — max simultaneous GitHub API requests
MAX_CONCURRENT_REQUESTS=10

# Pagination — max open PRs to analyze per request
MAX_PRS_TO_ANALYZE=100
