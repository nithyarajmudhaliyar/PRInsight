# ── REQUIRED ────────────────────────────────────────────────────────────────
# GitHub Personal Access Token (required — app will not start without this)
# Obtain from: GitHub → Settings → Developer settings → Personal access tokens
# Required scope: public_repo (read-only access to public repositories)
GITHUB_TOKEN=ghp_your_personal_access_token_here

# ── OPTIONAL ────────────────────────────────────────────────────────────────
# Application
DEBUG=true
LOG_LEVEL=DEBUG

# CORS — allowed frontend origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173"]

# Cache — in-memory TTL cache settings
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=100

# Concurrency — max simultaneous GitHub API requests
MAX_CONCURRENT_REQUESTS=10

# Pagination — max open PRs to analyze per request
MAX_PRS_TO_ANALYZE=100

# ── Rate Limiting ───────────────────────────────────────────────────────────
# Anonymous (per-IP) rate limits
RATE_LIMIT_ANON_MAX=10
RATE_LIMIT_ANON_WINDOW=60

# Authenticated (per-user) rate limits
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_AUTH_WINDOW=60

# ── GitHub OAuth (optional — required for user sign-in) ─────────────────────
# Create a GitHub OAuth App: GitHub → Settings → Developer settings → OAuth Apps
# Application URL: http://localhost:5173
# Callback URL:    http://localhost:8000/api/v1/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
FRONTEND_URL=http://localhost:5173
SESSION_SECRET_KEY=
SESSION_TTL_SECONDS=86400

# ── Production Settings ─────────────────────────────────────────────────────
# Set to true when serving over HTTPS (marks cookies as Secure)
COOKIE_SECURE=false
